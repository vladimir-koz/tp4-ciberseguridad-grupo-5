# Copiar a .env (ignorado por Git) o usar docker compose --env-file /ruta/privada.
# Generar dos contraseñas distintas, por ejemplo con: openssl rand -hex 32
# Completar ambas: Compose rechaza valores vacíos. No versionar las contraseñas.
# Estas variables de inicialización NO actualizan roles ni HBA de volúmenes existentes.

NODE_ENV=development
PORT=3000

# Puerto publicado en el host (docker-compose.yml)
APP_PORT=8080

DB_HOST=db
DB_PORT=5432
DB_NAME=origen
DB_USER=origen_app
POSTGRES_PASSWORD=
DB_PASSWORD=

UPLOADS_DIR=/app/uploads
